# Copie este arquivo para ".env" e preencha com suas chaves reais.
# NUNCA suba o arquivo ".env" para um repositório público — ele contém segredos.

# Chave da API da Anthropic (Claude). Crie a sua em https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo usado para analisar as reuniões (opcional).
ANTHROPIC_MODEL=claude-sonnet-5

# Chave da API da AssemblyAI, usada para transcrever o áudio das reuniões
# e identificar automaticamente quem falou. Crie a sua em https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Porta em que o servidor vai rodar (opcional).
PORT=3000
