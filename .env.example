# Copie este arquivo para ".env" e preencha com suas chaves reais.
# NUNCA suba o arquivo ".env" para um repositório público — ele contém segredos.

# Chave da API da Anthropic (Claude). Crie a sua em https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo usado para analisar as reuniões (opcional).
ANTHROPIC_MODEL=claude-sonnet-5

# Chave da API da AssemblyAI, usada para transcrever o áudio das reuniões
# e identificar automaticamente quem falou. Crie a sua em https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Porta em que o servidor vai rodar (opcional).
PORT=3000

# Endereço de conexão do banco de dados Postgres (ex: da conta grátis do Neon, neon.tech).
# Formato: postgresql://usuario:senha@host/nome-do-banco
DATABASE_URL=

# Texto secreto usado para assinar o login (qualquer frase longa e aleatória serve).
# Troque por algo só seu — quem tiver esse valor consegue forjar logins.
JWT_SECRET=

# Usuário e senha da conta de dono, criada automaticamente na primeira vez que o
# servidor rodar com o banco de dados vazio. Depois disso pode deixar em branco.
OWNER_USERNAME=
OWNER_PASSWORD=
